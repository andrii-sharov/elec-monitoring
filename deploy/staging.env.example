# Copy to /etc/elec/staging.env (root:root, 0600). Double-quote values with spaces; escape \ and " inside quotes.
DATABASE_URL="<Supabase staging transaction pooler URL, port 6543>"
HOST=127.0.0.1
PORT=3000
TRUST_PROXY_HOPS=1
JWT_SECRET="<openssl rand -base64 48>"
API_URL=https://staging-api.elec-monitoring.homes
CLIENT_URL=https://staging-app.elec-monitoring.homes
ADMIN_URL=https://staging-admin.elec-monitoring.homes
GOOGLE_CLIENT_ID="<staging OAuth web client ID>"
GOOGLE_CLIENT_SECRET="<staging OAuth web client secret>"
EMAIL_TRANSPORT=resend
RESEND_API_KEY="<staging Resend API key>"
EMAIL_FROM="Electricity Monitor <noreply@elec-monitoring.homes>"
