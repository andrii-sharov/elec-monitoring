[Unit]
Description=Electricity Monitor staging API
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=elec
Group=elec
WorkingDirectory=/opt/elec/staging/server
EnvironmentFile=/etc/elec/staging.env
ExecStart=/usr/bin/node dist/api.js
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
