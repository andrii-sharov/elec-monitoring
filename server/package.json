{
  "name": "@elec/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch --conditions=source --env-file-if-exists=.env src/api.ts",
    "dev:worker": "tsx watch --conditions=source --env-file-if-exists=.env src/worker.ts",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "NODE_OPTIONS=--conditions=source drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env dist/db/migrate.js",
    "fake-device": "tsx --conditions=source scripts/fake-device.ts",
    "telegram:webhook": "tsx --conditions=source --env-file-if-exists=.env scripts/telegram-webhook.ts"
  },
  "dependencies": {
    "@elec/shared": "*",
    "arctic": "^3.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "i18next": "^27.2.3",
    "jose": "^6.2.18",
    "postgres": "^4.1.1",
    "resend": "^6.39.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
